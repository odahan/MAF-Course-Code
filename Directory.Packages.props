    <PackageVersion Include="Microsoft.Agents.AI" Version="1.26.0" />
    <PackageVersion Include="Microsoft.Agents.AI.Harness" Version="1.26.0" />
    <PackageVersion Include="Microsoft.Agents.AI.Workflows" Version="1.26.0" />
    <PackageVersion Include="Microsoft.Extensions.AI" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="10.11.0" />
    <PackageVersion Include="OpenAI" Version="2.14.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.Abstractions" Version="10.11.0" />
    <PackageVersion Include="OllamaSharp" Version="5.5.0" />
    <PackageVersion Include="ModelContextProtocol" Version="2.3.0" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <PackageVersion Include="OpenTelemetry" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Exporter.Console" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.20.1" />
    <PackageVersion Include="JsonSchema.Net" Version="9.4.1" />
    <PackageVersion Include="Polly.Core" Version="8.8.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.13" />
    <PackageVersion Include="MSTest.TestFramework" Version="4.2.3" />
    <PackageVersion Include="MSTest.TestAdapter" Version="4.2.3" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.3.0" />
  </ItemGroup>
</Project>
