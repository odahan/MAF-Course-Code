<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>AgentOuSimpleCode.Episode02</AssemblyName>
    <RootNamespace>AgentOuSimpleCode.Episode02</RootNamespace>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <!-- Microsoft Agent Framework : création et exécution d'agents IA. -->
    <PackageReference Include="Microsoft.Agents.AI" />
    <!-- Abstractions IChatClient utilisées par MAF et implémentées par OllamaSharp. -->
    <PackageReference Include="Microsoft.Extensions.AI" />
    <!-- Client Ollama recommandé ici : il expose Ollama via IChatClient, sans appel HTTP manuel. -->
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../shared/Maf.Backlog/Maf.Backlog.csproj" />
    <None Include="../../shared/Configuration/ai-settings.json" Link="ai-settings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>