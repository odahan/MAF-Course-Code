<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>MafPromptJudgeDemo</AssemblyName>
    <RootNamespace>MafPromptJudgeDemo</RootNamespace>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../shared/Maf.Backlog/Maf.Backlog.csproj" />
    <None Update="prompts/**/*" CopyToOutputDirectory="PreserveNewest" />
    <None Update="evaluation/**/*" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../shared/Configuration/ai-settings.json" Link="ai-settings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

